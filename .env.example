WITHHUMAN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
WITHHUMAN_PUBLIC_ORIGIN=http://localhost:8080
WITHHUMAN_ENROLLMENT_CODE_TTL=10m
WITHHUMAN_PORT=8080
WITHHUMAN_VERSION=dev
POSTGRES_ADMIN_PASSWORD=replace-this-too
WITHHUMAN_DB_PASSWORD=replace-app-database-password
TEMPORAL_DB_PASSWORD=replace-temporal-database-password
# Keep this password aligned with WITHHUMAN_DB_PASSWORD. URL-encode it here
# when it contains reserved URL characters.
WITHHUMAN_DATABASE_URL=postgres://withhuman:replace-app-database-password@postgres:5432/withhuman?sslmode=disable


# Optional Slack app, one app per deployment. Set all four fields and the
# secrets key together. See deployment/slack/manifest.yaml.
WITHHUMAN_SLACK_APP_ID=
WITHHUMAN_SLACK_SIGNING_SECRET=
WITHHUMAN_SLACK_CLIENT_ID=
WITHHUMAN_SLACK_CLIENT_SECRET=
WITHHUMAN_SECRETS_KEY=
