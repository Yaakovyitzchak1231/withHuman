# Copy to .env and fill in. .env is ignored by git.

# withHuman: your server's AAP URL and an agent instance's API key
AAP_URL=http://localhost:8080/api/aap
AAP_INSTANCE_TOKEN=

# The model: OpenAI, or any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# For another endpoint, set its base URL, such as:
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/

# Claude Agent SDK example only: an Anthropic key, or sign in to Claude Code
# ANTHROPIC_API_KEY=
