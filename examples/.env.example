# Copy to .env and fill in. .env is ignored by git.

# withHuman: your server's AAP URL and an agent instance's API key
AAP_URL=http://localhost:8080/api/aap
AAP_INSTANCE_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Or Azure OpenAI: set these instead and the examples use them
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_VERSION=2025-04-01-preview

# Claude Agent SDK example only: an Anthropic key, or sign in to Claude Code
# ANTHROPIC_API_KEY=
