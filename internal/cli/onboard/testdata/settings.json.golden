{
  "permissions": {
    "allow": [
      "Bash(git status)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "AAP_CONFIG_DIR={{CONFIG}} {{BINARY}} hook claude-code",
            "timeout": 604860
          }
        ]
      }
    ]
  }
}
